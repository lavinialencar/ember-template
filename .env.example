# Copie para .env (que fica fora do git) e preencha. Nunca commite valores reais.
# Pras PLUGGY_*, BACKUP_DESTINO e BACKUP_CERT, variavel de ambiente com o mesmo nome ganha do .env
# (util no contêiner e no CI). As outras sao lidas so do .env; excecao: o suspeitas.py le EMBER_TZ
# so do ambiente (no contêiner ele ja vem do docker-compose.scripts.yml).

# ---- Pluggy (Open Finance) ----------------------------------------------------------
# Credenciais da sua Application no dashboard da Pluggy.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Conexoes a baixar: "rotulo:itemId" separados por virgula. O rotulo ([a-z0-9_], ate 30) e o nome
# da fonte no painel, nas regras e no cadastro manual; o itemId e o UUID da conexao feita pelo
# MeuPluggy (conexao pelo MeuPluggy nao expira). Exemplo com ids falsos:
PLUGGY_ITEM_IDS=banco_a:00000000-0000-4000-8000-00000000000a,banco_b:00000000-0000-4000-8000-00000000000b

# ---- Push dos alertas (ntfy) ----------------------------------------------------------
# Servidor publico por padrao. Com ntfy proprio (docker-compose.ntfy.yml), troque a URL.
NTFY_URL=https://ntfy.sh
# No ntfy.sh publico o topico e o segredo: longo e aleatorio, o mesmo assinado no app do celular.
NTFY_TOPIC=ember-troque-por-um-nome-longo-e-aleatorio
# So se o ntfy proprio pedir login (token de acesso do ntfy).
NTFY_TOKEN=
# Onde o ntfy proprio escuta (docker-compose.ntfy.yml). Padrao 127.0.0.1; pelo Tailscale, o IP 100.x.y.z
# do servidor (`tailscale ip -4`). Nunca 0.0.0.0.
NTFY_BIND=127.0.0.1
# URL publica do ntfy proprio, ex. http://<servidor>.<tailnet>.ts.net:8081 (so pro docker-compose.ntfy.yml).
NTFY_BASE_URL=

# ---- Botoes dos alertas (webhook do agendador.py) -------------------------------------
# Segredo que assina os botoes (ntfy.sh) e protege o webhook. Minimo 32 caracteres; sem ele os botoes
# ficam desligados e o webhook nao sobe. Gere com:
#   python3 -c "import secrets;print(secrets.token_urlsafe(36))"
ALERTA_WEBHOOK_TOKEN=
# So com ntfy proprio: endereco do webhook que os botoes chamam, ex. http://<servidor>.<tailnet>.ts.net:8082/alerta
ALERTA_WEBHOOK_URL=

# ---- Agendador (scripts/agendador.py, contêiner ember-scripts) -----------------------
# Interface onde o webhook escuta. Padrao 127.0.0.1; pelo Tailscale, o IP 100.x.y.z do servidor. Nunca 0.0.0.0.
EMBER_BIND=127.0.0.1
EMBER_PORTA=8082
# Hora da rotina diaria (HH:MM, no fuso EMBER_TZ).
EMBER_HORA=09:09
# Fuso da rotina, das tarefas no TickTick e da hora "sem hora" dos lancamentos de banco.
EMBER_TZ=America/Sao_Paulo

# ---- TickTick (opcional) ---------------------------------------------------------------
# Com token, o botao "Criar no TickTick" cria a tarefa na hora; sem ele, a tarefa fica na fila
# (python3 scripts/notificar.py --pendentes).
TICKTICK_TOKEN=
TICKTICK_PROJECT_ID=

# ---- Postgres (docker-compose.yml) -----------------------------------------------------
# Senha longa e aleatoria; tambem usada pelo agendador.py pra carregar data/carga.sql.
POSTGRES_PASSWORD=

# ---- Backup criptografado (scripts/backup.py) -----------------------------------------
# Pasta onde os backups vao (ex.: uma pasta sincronizada com a nuvem). Obrigatorio pro backup rodar;
# sem ele use atualizar.py --sem-backup.
BACKUP_DESTINO=
# Certificado PUBLICO (so tranca). Padrao scripts/backup_cert.pem, que nao vem no repositorio.
# A chave privada, que destranca, nunca fica nesta maquina.
BACKUP_CERT=
