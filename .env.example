# Copy to .env (which stays outside git) and fill it in. Never commit real values.
# For PLUGGY_*, BACKUP_DEST and BACKUP_CERT, an environment variable with the same name wins over .env
# (useful in the container and in CI). The others are read from .env only; exception: suspicious.py reads EMBER_TZ
# from the environment only (in the container it already comes from docker-compose.scripts.yml).

# ---- Pluggy (Open Finance) ----------------------------------------------------------
# Credentials of your Application in the Pluggy dashboard.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Connections to fetch: "label:itemId" separated by commas. The label ([a-z0-9_], up to 30) is the name
# of the source in the dashboard, in the rules and in the manual records; the itemId is the UUID of the connection made
# through MeuPluggy (a MeuPluggy connection does not expire). Example with fake ids:
PLUGGY_ITEM_IDS=banco_a:00000000-0000-4000-8000-00000000000a,banco_b:00000000-0000-4000-8000-00000000000b

# ---- Alert push (ntfy) ----------------------------------------------------------------
# Public server by default. With your own ntfy (docker-compose.ntfy.yml), change the URL.
NTFY_URL=https://ntfy.sh
# On public ntfy.sh the topic is the secret: long and random, the same one subscribed in the phone app.
NTFY_TOPIC=ember-replace-with-a-long-random-name
# Only if your own ntfy asks for login (ntfy access token).
NTFY_TOKEN=
# Where your own ntfy listens (docker-compose.ntfy.yml). Default 127.0.0.1; through Tailscale, the server's
# 100.x.y.z IP (`tailscale ip -4`). Never 0.0.0.0.
NTFY_BIND=127.0.0.1
# Public URL of your own ntfy, e.g. http://<server>.<tailnet>.ts.net:8081 (only for docker-compose.ntfy.yml).
NTFY_BASE_URL=

# ---- Alert buttons (scheduler.py webhook) ---------------------------------------------
# Secret that signs the buttons (ntfy.sh) and protects the webhook. At least 32 characters; without it the buttons
# are off and the webhook does not start. Generate it with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(36))"
ALERT_WEBHOOK_TOKEN=
# Only with your own ntfy: address of the webhook the buttons call, e.g. http://<server>.<tailnet>.ts.net:8082/alert
ALERT_WEBHOOK_URL=

# ---- Scheduler (scripts/scheduler.py, ember-scripts container) ------------------------
# Interface the webhook listens on. Default 127.0.0.1; through Tailscale, the server's 100.x.y.z IP. Never 0.0.0.0.
EMBER_BIND=127.0.0.1
EMBER_PORT=8082
# Time of the daily routine (HH:MM, in the EMBER_TZ time zone).
EMBER_TIME=09:09
# Time zone of the routine, of the TickTick tasks and of the "no time" hour of bank entries.
EMBER_TZ=America/Sao_Paulo

# ---- TickTick (optional) ---------------------------------------------------------------
# With a token, the "Create in TickTick" button creates the task right away; without it, the task waits in the queue
# (python3 scripts/notify.py --pending).
TICKTICK_TOKEN=
TICKTICK_PROJECT_ID=

# ---- Postgres (docker-compose.yml) -----------------------------------------------------
# Long random password; also used by scheduler.py to load data/load.sql.
POSTGRES_PASSWORD=

# ---- Encrypted backup (scripts/backup.py) ---------------------------------------------
# Folder where the backups go (e.g. a folder synced to the cloud). Required for the backup to run;
# without it use update.py --no-backup.
BACKUP_DEST=
# PUBLIC certificate (it only locks). Default scripts/backup_cert.pem, which does not ship with the repository.
# The private key, which unlocks, never stays on this machine.
BACKUP_CERT=
