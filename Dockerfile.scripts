# Container for Ember's scripts (daily routine and alert button webhook), to run on an always-on server.
FROM python:3.14.0-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client openssl ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
# time zone of the daily routine and of TickTick; change it at build time or through EMBER_TZ in docker-compose.scripts.yml
ARG EMBER_TZ=America/Sao_Paulo
ENV TZ=${EMBER_TZ} EMBER_TZ=${EMBER_TZ} PYTHONUNBUFFERED=1
# no root: the repo mounted at /app must belong to this uid (see docker-compose.scripts.yml)
ARG EMBER_UID=1000
ARG EMBER_GID=1000
RUN groupadd -g ${EMBER_GID} ember && useradd -u ${EMBER_UID} -g ember -M -s /usr/sbin/nologin ember
USER ember
WORKDIR /app
CMD ["python3", "scripts/scheduler.py"]
